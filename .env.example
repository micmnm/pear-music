# =============================================================================
# Pear Music — environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values. Nothing in `.env` is
# committed to git (see .gitignore).
# =============================================================================

# --- Frontend (Vite build-time, embedded in the SPA bundle) -------------------
# Used by: src/client/supabase.ts
# These end up in the client bundle — use the ANON key here, NOT the service key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# Edge Function secrets (NOT read from this file)
# =============================================================================
# The following secrets must be set in the Supabase dashboard:
#   Project → Edge Functions → Secrets
# They are used at runtime by supabase/functions/auth/index.ts and cannot
# be overridden by this file.
#
#   WEBAUTHN_RP_ID      — Your domain, e.g. "music.example.com"
#                         (no protocol, no path, no trailing slash)
#   WEBAUTHN_ORIGIN     — Full origin, e.g. "https://music.example.com"
#                         (this is what passkeys are bound to — changing it
#                         will invalidate all existing passkeys)
#
# The auth Edge Function throws on startup if these are missing.
#
# Supabase automatically injects these, do NOT set them manually:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY
# =============================================================================

# =============================================================================
# CI/CD secrets (only if using the provided .woodpecker.yml)
# =============================================================================
# Configure in Woodpecker UI → Repo → Settings → Secrets. Not read from this
# file. Listed here for reference.
#
#   supabase_url              — Same value as VITE_SUPABASE_URL above
#   supabase_anon_key         — Same value as VITE_SUPABASE_ANON_KEY above
#   docker_registry           — Registry host, e.g. "registry.example.com"
#   docker_registry_user      — Registry username
#   docker_registry_password  — Registry password
#   kubeconfig                — Full kubeconfig file contents (multi-line)
#   k8s_namespace             — Namespace to deploy into
# =============================================================================
